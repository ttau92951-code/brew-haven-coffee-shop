# =========================================================
# BREW HAVEN - FRONTEND ENVIRONMENT VARIABLES
# Copy this file to ".env" (local) or add these keys in your
# Vercel / Netlify project settings.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets (JWT_SECRET, Redis tokens, passwords) here.
# =========================================================

# Base URL of the Brew Haven Express API, including the /api suffix.
# Local development:
VITE_API_URL=http://localhost:5000/api

# Production (Render example):
# VITE_API_URL=https://brew-haven-api.onrender.com/api
