# =========================================================
# BREW HAVEN - BACKEND ENVIRONMENT VARIABLES
# Copy this file to ".env" and replace the placeholder values.
# NEVER commit the real ".env" file to GitHub.
# =========================================================

# Upstash Redis (key-value NoSQL database with persistence enabled)
# Create a database at https://console.upstash.com and copy the REST credentials.
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Secret used to sign JSON Web Tokens. Use a long, random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Staff account used to access the management dashboard.
# Generate the hash with: node hashPassword.js
STAFF_USERNAME=admin
STAFF_PASSWORD_HASH=$2a$12$replace_with_a_bcrypt_hash

# Comma-separated list of trusted frontend origins (production URLs).
# Localhost origins are always allowed during development.
FRONTEND_URL=https://your-frontend.vercel.app

# Port the Express server listens on (Render sets this automatically).
PORT=5000
